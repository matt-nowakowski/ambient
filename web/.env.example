# ---------------------------------------------------------------------------
# Website + licensing API environment variables.
# Copy to .env.local for local development. NEVER commit real values.
# The site builds and renders with none of these set; the checkout/licensing
# routes then return 503 "not_configured".
# ---------------------------------------------------------------------------

# Public base URL of this site, used for the Polar checkout success URL and
# metadata, sitemap, robots and llms.txt. No trailing slash.
# Defaults to https://<domain> from brand.config.json. Use
# http://localhost:3000 in .env.local for local checkout testing.
NEXT_PUBLIC_APP_URL=https://tryambient.ai

# Polar (merchant of record). Organization access token, server-side only.
POLAR_ACCESS_TOKEN=
# "production" or "sandbox" (default sandbox).
POLAR_ENV=sandbox

# Polar product IDs for Pro. Polar models each billing interval as its own
# recurring product: one monthly, one yearly.
POLAR_PRODUCT_PRO_MONTHLY=
POLAR_PRODUCT_PRO_YEARLY=

# Ed25519 private key that signs license keys. PKCS8 PEM.
# Multi-line PEM is fine in .env.local if quoted; on Vercel you may paste it
# as one line with literal "\n" escapes — both are accepted.
# The matching raw public key (base64) is `licensePublicKey` in brand.config.json
# and is embedded in the desktop app.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# App sign-in (email + 6-digit code). ≥ 32 random chars, e.g. `openssl rand -base64 48`.
# Signs sign-in challenges and sessions. Optional: without it a secret is derived from
# LICENSE_PRIVATE_KEY. Rotating it signs everyone out of the app (Pro keeps working
# until their token expires, then they sign in again). Codes are emailed via RESEND_API_KEY.
AUTH_SECRET=

# Local testing only: "1" skips the Polar active-subscription check when a license
# code is activated (fake subjects have no subscription). Ignored in production
# builds and on Vercel. Never set it in Vercel.
# LICENSE_CODE_TEST_BYPASS=1

# ---------------------------------------------------------------------------
# Admin dashboard (/admin). All three required, or /admin is a 404.
# ---------------------------------------------------------------------------
# Comma-separated allowlist, case-insensitive.
ADMIN_EMAILS=
# scrypt:<N>:<r>:<p>:<salt b64>:<key b64> — generate with `bun scripts/admin-hash.ts`.
ADMIN_PASSWORD_HASH=
# ≥ 32 random characters, e.g. `openssl rand -base64 48`. Rotating it signs everyone out.
ADMIN_SESSION_SECRET=

# Optional: Polar team product id(s), comma-separated, for the Organizations table.
POLAR_PRODUCT_TEAM=

# Optional, read-only provider keys that turn admin cards from manual to live.
VERCEL_API_TOKEN=
NEON_API_KEY=
NEON_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ELEVENLABS_API_KEY=
IMPROVMX_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Email (see README "Email"). All optional: without them nothing is sent.
# ---------------------------------------------------------------------------
# RESEND_API_KEY is above. Polar → Settings → Webhooks → the endpoint's secret.
POLAR_WEBHOOK_SECRET=
# ≥ 32 random chars, e.g. `openssl rand -base64 48`. Signs confirm/unsubscribe links;
# rotating it breaks the links in emails already sent.
EMAIL_TOKEN_SECRET=
# Resend segment ids (formerly Audiences). Optional: found or created by name on first use.
RESEND_AUDIENCE_CUSTOMERS=
RESEND_AUDIENCE_NEWSLETTER=

# ---------------------------------------------------------------------------
# Marketing (/admin/marketing and the media kit). All optional.
# ---------------------------------------------------------------------------
# Creator uploads go straight from the browser to R2 (bucket ambient-builds,
# under marketing/) with presigned URLs; these sign them. Same names as the
# GitHub release secrets; an R2 API token with Object Read & Write on the bucket.
# The bucket also needs a CORS policy allowing PUT from this site (shown in the tab).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional, default ambient-builds.
# R2_BUCKET=
# The influencer media kit lives at /kit/<MEDIA_KIT_TOKEN>. ≥ 24 random chars,
# letters and digits, e.g. `openssl rand -base64 32 | tr -d '/+='`. Unset = kit off.
# Change it and redeploy to revoke every shared link.
MEDIA_KIT_TOKEN=
