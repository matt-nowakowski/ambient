{
  "defaults": {
    "tags": ["joining", "dictate"],
    "plan": "pro",
    "settings": {
      "intelligence": "none",
      "polish": false,
      "writing": "as_said"
    }
  },
  "cases": [
    {
      "id": "join.en.second-take",
      "about": "A second take into the same field continues the sentence: a space, and no capital on a common word.",
      "tags": ["critical", "regression"],
      "lang": "en",
      "screen": {
        "app": {
          "macos": "Notes",
          "windows": "Notepad",
          "linux": "Text Editor"
        },
        "bundle": {
          "macos": "com.apple.Notes",
          "windows": "notepad.exe",
          "linux": "org.gnome.texteditor"
        },
        "title": "Notes",
        "text": "We're just staying in San Miguel",
        "focus": {
          "role": "AXTextArea",
          "editable": true,
          "value": "We're just staying in San Miguel"
        }
      },
      "say": "Not doing much to be honest",
      "expect": {
        "route": "write",
        "typed": " not doing much to be honest",
        "must_not": ["model_call"]
      },
      "regression": "0.1.11: two dictations in a row typed \"San MiguelNot doing much\""
    },
    {
